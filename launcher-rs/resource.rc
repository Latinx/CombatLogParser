#include <winver.h>

// RT_MANIFEST
1 RT_MANIFEST "manifest.xml"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VS_FF_PRERELEASE
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WoWAnalyzer"
            VALUE "FileDescription",  "Combat Log Parser - Local WoW Combat Log Analyzer"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "combat-log-parser-launcher"
            VALUE "LegalCopyright",   "Copyright (c) WoWAnalyzer"
            VALUE "OriginalFilename", "CombatLogParser.exe"
            VALUE "ProductName",      "Combat Log Parser"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
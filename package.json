{
  "name": "combatlogparser",
  "version": "0.3.0",
  "description": "A WoW combatlog parser by WoWAnalyzer.",
  "type": "module",
  "main": "src/index.js",
  "bin": "server.cjs",
  "scripts": {
    "start": "nodemon src/index.js",
    "start:app": "node server.cjs",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "eslint .",
    "build": "node --check src/index.js && node --check server.cjs",
    "prod": "node src/index.js",
    "build:win": "pkg . --targets node20-win-x64 --output dist/CombatLogParser.exe"
  },
  "pkg": {
    "assets": [
      "index.html"
    ]
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@yao-pkg/pkg": "^5.16.1",
    "dotenv": "^16.4.7",
    "eslint": "^10.8.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9"
  }
}
